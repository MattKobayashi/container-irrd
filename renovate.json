{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^(.*/)?node$/"
      ],
      "allowedVersions": "<=20"
    },
    {
      "matchPackageNames": [
        "/^(.*/)?postgres$/"
      ],
      "allowedVersions": "<=18"
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}